{
  "name": "freeipa-server-gpo-frontend",
  "private": true,
  "description": "Sources of the GPUI editor. The build writes the AMD artifact into ../plugin/ui/grouppolicy/js, which is committed and installed by the RPM.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build --logLevel warn",
    "build:check": "node scripts/check-artifact.mjs",
    "watch": "vite build --watch --logLevel warn",
    "dev": "vite",
    "lint": "eslint src dev scripts tests *.mjs",
    "typecheck": "tsc -p . --pretty false",
    "test": "node scripts/build-test-root.mjs && node --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:ipa": "bash scripts/ipa-up.sh && REQUIRE_IPA=1 node --test \"tests/e2e/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright": "^1.50.0",
    "requirejs": "^2.3.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
