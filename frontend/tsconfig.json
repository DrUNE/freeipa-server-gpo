{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "paths": {
      "freeipa/*": [
        "./types/freeipa/*"
      ]
    }
  },
  "include": [
    "types/**/*.d.ts",
    "src/**/*.js"
  ]
}